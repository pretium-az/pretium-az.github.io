---
layout: "base.njk" 
title: Digital Solutions - SW Development, AI, Data
---

<!-- Services -->
<section class="flex flex-col sm:gap-5 gap-3 z-1">

  <h2 class="text-center sm:text-5xl text-3xl font-semibold mb-0">
    How Can We <span class="text-red-700">Help Your Business</span>
  </h2>

  <p class="text-center sm:text-xl text-lg mb-0">
    From startups to Fortune 500 companies, we create software that drives success
  </p>

  <div class="flex justify-center">
    <a href="/services" class="px-4 py-2 font-medium bg-red-700 hover:bg-red-800 text-white rounded-md">
      All Services
    </a>
  </div>
</section>

<!-- Services -->
<section class="grid grid-cols-12 gap-6 mt-10 z-1">

  {% for service in collections.homeServices %}
  <div class="md:col-span-4 sm:col-span-6 col-span-12 bg-white border border-slate-300 p-4 rounded-xl">
  
    <span class="bg-slate-50 border border-slate-300 p-2 text-5xl inline-flex items-center rounded-md text-red-700">
      {{ service.data.icon | safe }}
    </span>
    
    <h3 class="sm:text-3xl text-2xl font-bold mt-3">
      {{ service.data.title }}
    </h3>

  </div>

  {% endfor %}

</section>

<!-- Slider -->
<section class="flex flex-col gap-2 mt-10">

  <h2 class="text-center sm:text-5xl text-3xl font-semibold mb-0"><span class="text-red-700">Our Impact</span> in Numbers</h2>

  <p class="text-center sm:text-xl text-lg text-slate-600 mb-0">We've delivered hundreds of successful projects in various industries</p>

  <div class="grid grid-cols-12 p-6 bg-white rounded-2xl gap-5 sm:mt-9 mt-4">
    <div class="sm:col-span-4 col-span-12 bg-slate-100 flex flex-col p-4 gap-2 items-center rounded-2xl">
      <span class="text-red-700 sm:text-5xl text-3xl font-extrabold">120+</span>
      <span class="sm:text-xl text-lg font-medium text-center">projects completed</span>
    </div>
    <div class="sm:col-span-4 col-span-12 bg-slate-100 flex flex-col p-4 gap-2 items-center rounded-2xl">
      <span class="text-red-700 sm:text-5xl text-3xl font-extrabold">13</span>
      <span class="sm:text-xl text-lg font-medium text-center">industries covered</span>
    </div>
    <div class="sm:col-span-4 col-span-12 bg-slate-100 flex flex-col p-4 gap-2 items-center rounded-2xl">
      <span class="text-red-700 sm:text-5xl text-3xl font-extrabold">14</span>
      <span class="sm:text-xl text-lg font-medium text-center">years on the market</span>
    </div> 

    <div class="col-span-12 rounded-xl overflow-hidden">
      <!-- Slider main container -->
      <div class="swiper">   
        <!-- Additional required wrapper -->
        <div class="swiper-wrapper"> 
          <!-- Slides -->
          <div class="swiper-slide sm:aspect-5/2 aspect-5/3">
            <img 
              src="https://cdn.prod.website-files.com/669e317d79600bcb185a8939/680bcb29188894b1bc461a85_0ced1c1c1ae68de47e0087dc9a5e104e_0145-moravio-web-p-2000.webp"
              class="object-cover w-full h-full">
          </div>
          <div class="swiper-slide sm:aspect-5/2 aspect-5/3">
            <img 
              src="https://cdn.prod.website-files.com/669e317d79600bcb185a8939/680b5ed268ad433ffca7e905_308acd7d028788de32ae1768bd1dd9a4_0169-moravio-web%20%281%29-p-2000.jpg"
              class="object-cover w-full h-full">
          </div>
          <div class="swiper-slide sm:aspect-5/2 aspect-5/3">
            <img 
              src="https://cdn.prod.website-files.com/669e317d79600bcb185a8939/680b540c35fb8d6307cc6103_04e296202cef9d1748784345b3d85c44_4O5A9691%20%281%29-p-2000.webp"
              class="object-cover w-full h-full">
          </div>
        </div>
        <!-- If we need pagination -->
        <div class="swiper-pagination"></div>

        <!-- If we need navigation buttons -->
        {# <div class="swiper-button-prev"></div> #}
        {# <div class="swiper-button-next"></div> #}

        <!-- If we need scrollbar -->
        {# <div class="swiper-scrollbar"></div> #}
      </div>
    </div>

  </div>

</section>

<!-- Brands -->
<section class="flex flex-col gap-4 mt-10">
  <h2 class="text-center sm:text-5xl text-3xl font-semibold mb-0">
    <span class="text-red-700">Trusted by</span> Leading Brands
  </h2>
  <div class="grid grid-cols-12 justify-center sm:gap-6 gap-3">
    {% for brand in brands %} 
    <a 
      href="{{ brand.url }}"
      class="lg:col-span-2 md:col-span-3 sm:col-span-4 col-span-6 bg-white border border-slate-300 p-4 rounded-xl aspect-3/1 flex justify-center">
      <img 
        src="{{ brand.img }}"
        class="object-contain">
    </a>
    {% endfor %}
  </div>
</section>

