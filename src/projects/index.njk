---
layout: base.njk
title: Projects
---

<h2 class="text-center text-5xl font-semibold">{{ title }}</h2>

<!-- Projects -->
<section class="flex flex-col gap-4 mt-10">
  <div class="grid grid-cols-12 justify-center sm:gap-6 gap-3">
    {% for project in projects %} 
      <div 
        class="col-span-4 bg-slate-100  rounded-xl py-4 px-10 flex flex-col gap-7 items-center justify-center">
        <img src="{{project.img}}" class="w-[60%]">
        <span class="text-xl text-center block font-semibold">{{project.title}}</span>
      </div>
    {% endfor %}
  </div>
</section>